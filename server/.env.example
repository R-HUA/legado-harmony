PORT=8080
HOST=127.0.0.1
# Apply migration 016 first. Sales remain disabled per product until all benefits pass acceptance.
MEMBERSHIP_ENABLED=false
MEMBERSHIP_SOURCE_LIMITS_ENABLED=false
# Optional purchase pilot: all three required; UUIDs only, never nicknames.
# Public sales flags remain false. These accounts may buy only the listed SKUs until the given time.
# Example expiry format: 2026-10-22T20:00:00+08:00. Empty values disable the pilot.
MEMBERSHIP_PILOT_USER_IDS=
MEMBERSHIP_PILOT_SKUS=
MEMBERSHIP_PILOT_UNTIL=
# Private OBS bucket; App uploads/downloads via signed URLs. Apply migration 018.
# Required lifecycle: delete qingye/staging/ after 1 day; never expire qingye/v1/.
# Keep disabled until integration and authorization-quota verification pass.
CLOUD_FILES_ENABLED=false
HUAWEICLOUD_OBS_ENDPOINT=
HUAWEICLOUD_OBS_REGION=
HUAWEICLOUD_OBS_BUCKET=
HUAWEICLOUD_OBS_AK=
HUAWEICLOUD_OBS_SK=
DATABASE_URL=postgres://legado:change-me@127.0.0.1:5432/legado
SESSION_SECRET=replace-with-at-least-32-random-bytes

HUAWEI_CLIENT_ID=replace-with-agc-oauth-client-id
HUAWEI_CLIENT_SECRET=replace-with-agc-oauth-client-secret
# Native Account Kit normally leaves this empty. Set it only when the AGC OAuth client requires one.
HUAWEI_REDIRECT_URI=

HUAWEI_APP_ID=replace-with-agc-app-id
HUAWEI_BUNDLE_NAME=io.legado.read

# IAP server API values generated/configured in AppGallery Connect.
HUAWEI_IAP_KEY_ID=replace-with-key-id
HUAWEI_IAP_ISSUER_ID=replace-with-issuer-id
HUAWEI_IAP_PRIVATE_KEY_PATH=/run/secrets/huawei-iap-private-key.p8
HUAWEI_IAP_ROOT_CA_PATH=/run/secrets/RootCaG2Ecdsa.cer
# Select the IAP site root URL from Huawei's current "site information" document.
HUAWEI_IAP_ROOT_URL=https://replace-with-current-iap-site-root
# Fail closed: set this to the exact paid/deliverable values in Huawei's current site documentation.
HUAWEI_IAP_DELIVERABLE_STATUSES=0,PAID,PURCHASED,SUCCESS,SUCCEEDED,COMPLETED
HUAWEI_IAP_REVOCATION_STATUSES=2,3,4,5,CANCELED,CANCELLED,REFUNDED,REVOKED,FAILED,EXPIRED
HUAWEI_IAP_RECONCILIATION_INTERVAL_MS=21600000
HUAWEI_IAP_RECONCILIATION_BATCH_SIZE=50

# HTTP, session and database availability protection.
TRUSTED_PROXIES=127.0.0.1,::1
UPSTREAM_HTTP_TIMEOUT_MS=15000
GLOBAL_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
SENSITIVE_RATE_LIMIT_PER_MINUTE=20
# Paginated cloud-sync exchanges use a larger, separate request budget.
SYNC_RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_DAYS=7
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Optional Huawei Cloud SIS online TTS. The API stays disabled until AK, SK
# and project ID are all configured. Keep these values on the server only.
HUAWEICLOUD_SIS_AK=replace-with-iam-access-key
HUAWEICLOUD_SIS_SK=replace-with-iam-secret-key
HUAWEICLOUD_SIS_PROJECT_ID=replace-with-cn-north-4-project-id
HUAWEICLOUD_SIS_REGION=cn-north-4
HUAWEICLOUD_SIS_ENDPOINT=https://sis-ext.cn-north-4.myhuaweicloud.com
# One billing unit is 100 standard characters or 50 premium characters.
HUAWEICLOUD_SIS_DAILY_BILLING_UNIT_LIMIT=25000
HUAWEICLOUD_SIS_USER_REQUESTS_PER_MINUTE=30
# 2C/2GB single-instance defaults. Increase only after observing memory and bandwidth.
HUAWEICLOUD_SIS_MAX_CONCURRENT=6
HUAWEICLOUD_SIS_MAX_CONCURRENT_PER_USER=2
HUAWEICLOUD_SIS_QUEUE_LIMIT=20
HUAWEICLOUD_SIS_QUEUE_TIMEOUT_MS=10000
HUAWEICLOUD_SIS_CACHE_MAX_BYTES=134217728
HUAWEICLOUD_SIS_CACHE_MAX_ENTRY_BYTES=8388608
HUAWEICLOUD_SIS_CACHE_TTL_MS=300000
# Terminal TTS request details are operational diagnostics, not the billing ledger.
TTS_USAGE_RETENTION_DAYS=30

# Sync JSON responses are gzip-compressed when the client advertises support.
SYNC_REQUEST_BODY_LIMIT_BYTES=2097152
SYNC_RESPONSE_BODY_LIMIT_BYTES=2097152
SYNC_MAX_DEVICES_PER_USER=20
SYNC_MAX_ENTITIES_PER_USER=20000
SYNC_MAX_ENTITY_BYTES_PER_USER=134217728
# Lightweight latest-change markers; they no longer contain payload history.
SYNC_MAX_CHANGES_PER_USER=100000
SYNC_MAX_CHANGE_BYTES_PER_USER=268435456
SYNC_MAX_DAILY_WRITES_PER_USER=5000
# Every account gets this one-time 24-hour window for its first large upload.
SYNC_INITIAL_MAX_DAILY_WRITES_PER_USER=20000
SYNC_INITIAL_WINDOW_MS=86400000
SYNC_RESPONSE_COMPRESSION_THRESHOLD_BYTES=1024
# Idempotency receipts older than this are removed in small background batches.
SYNC_RECEIPT_RETENTION_DAYS=3
SYNC_MAINTENANCE_INTERVAL_MS=21600000
